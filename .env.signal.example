# Signal service environment template. Copy relevant keys into your .env.
# SIGNAL_SERVICE_LISTEN=:8480
SIGNAL_SERVICE_INTERVAL=3m
# Set to a Hyperliquid main-wallet address to enable real self-wallet book-PnL
# and liquidation anchors in the heatmap / signal-lab products.
# HYPERLIQUID_WALLET_ADDR=0x...
# Optional Pineify augmentation (secret — never commit the token).
# PINEIFY_MCP_TOKEN=...
# PINEIFY_BASE_URL=https://agents.pineify.app/mcp
PINEIFY_RATE_PER_MINUTE=3
